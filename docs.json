            "pages": [
              "index",
              "docs/quickstart"
            ]
          },
          {
            "group": "Detections",
            "pages": [
              "docs/detections/detections",
              "docs/detections/converters",
              "docs/detections/filters"
            ]
          },
          {
            "group": "Annotators",
            "pages": [
              "docs/annotators/introduction",
              "docs/annotators/box",
              "docs/annotators/label",
              "docs/annotators/mask",
              "docs/annotators/polygon",
              "docs/annotators/oval",
              "docs/annotators/blur",
              "docs/annotators/pixelate",
              "docs/annotators/zones"
            ]
          },
          {
            "group": "Zones",
            "pages": [
              "docs/zones/introduction",
              "docs/zones/polygon_zones",
              "docs/zones/crossings",
              "docs/zones/strategies"
            ]
          },
          {
            "group": "Object Tracking",
            "pages": [
              "docs/trackers/bytetracker"
            ]
          },
          {
            "group": "Processing Tools",
            "pages": [
              "docs/buffer",
              "docs/smoother",
              "docs/slicer",
              "docs/colors"
            ]
          },
          {
            "group": "Analytics",
            "pages": [
              "docs/timetracker"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/docs/logo/light.svg",
    "dark": "/docs/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/datamarkin/pixelflow"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try Datamarkin",
      "href": "https://datamarkin.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/datamarkin/pixelflow",
      "x": "https://x.com/datamarkin"
    }
